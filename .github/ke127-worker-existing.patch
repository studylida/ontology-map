+def _retry_after(error: Exception) -> timedelta | None:
+    response = getattr(error, "response", None)
+    if not isinstance(response, httpx.Response):
+        return None
+    value = response.headers.get("Retry-After")
+    if value is None:
+        return None
+    try:
+        return timedelta(seconds=max(0, int(value)))
+    except (ValueError, OverflowError):
+        try:
+            when = parsedate_to_datetime(value)
+            if when.utcoffset() is None:
+                return None
+            return max(timedelta(0), when - datetime.now(UTC))
+        except (ValueError, TypeError, OverflowError):
+            return None
+
+
+def _provider_error(error: Exception) -> CallFailed:
+    """Classify status/typed transport errors without retaining provider text."""
+    status = getattr(error, "status_code", None)
+    if type(status) is int:
+        if status in (401, 403):
+            return CallFailed("AUTHENTICATION_ERROR", fatal=True)
+        if status in (400, 404, 405, 413, 415, 422):
+            return CallFailed("INVALID_REQUEST", fatal=True)
+        if status == 429:
+            return CallFailed(
