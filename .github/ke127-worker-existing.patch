+        if status == 408 or status == 504:
+            return CallFailed("TIMEOUT", fatal=True, transient=True)
+        return CallFailed(
+            "PROVIDER_ERROR", fatal=True, transient=500 <= status <= 599,
+            retry_after=_retry_after(error),
+        )
